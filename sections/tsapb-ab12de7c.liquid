					{%- capture image_css_variables -%}
												--section-icon-color: {{- image_block.settings.icon_color -}};
												--section-icon-size: {{- image_block.settings.icon_size -}}px;
												--block-image-corner-radius: {{- image_block.settings.image_corner_radius -}}px;
												--section-image-width: {{- image_block.settings.image_width -}}px;
											{%- endcapture -%}

					{%- liquid
						assign icon = image_block.settings.icon
						assign font_awesome = image_block.settings.font_awesome
						assign image = image_block.settings.image
						assign icon_type = image_block.settings.icon_type
						assign sizes = image_block.settings.image_width | append: "px"
					-%}

					<div
						class="VtlsAnnouncementBannerImage"
						style="{{- image_css_variables | strip_newlines -}}"
						{{ image_block.shopify_attributes }}
					>
						<div class="VtlsAnnouncementBannerImage__MediaWrapper">
							{%- if font_awesome != blank and icon_type == "icon" -%}
								{% unless content_for_header contains "font-awesome" %}
									<link
										rel="stylesheet"
										href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"
										integrity="sha384-DyZ88mC6Up2uqS4h/KRgHuoeGwBcD4Ng9SiP4dIRy0EXTlnuz47vAwmeGwVChigm"
										crossorigin="anonymous"
									>
								{% endunless %}
								<div class="VtlsAnnouncementBannerImage__Icon">
									<span aria-hidden="true">{{ font_awesome }}</span>
								</div>
							{%- elsif icon != blank and icon_type == "icon" -%}
								<div class="VtlsAnnouncementBannerImage__Icon">
									<span aria-hidden="true">{{ vtls_icon }}</span>
								</div>
							{%- elsif image != blank -%}
								<div class="VtlsAnnouncementBannerImage__Image">
									{{-
										image
										| image_url: width: image.width
										| image_tag:
											sizes: sizes,
											widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
											loading: loading,
											fetchpriority: fetchpriority,
											preload: preload
									-}}
								</div>
							{%- else -%}
								<div class="VtlsAnnouncementBannerImage__Image">
									<img
										src="data:image/webp;base64,"
										alt="Decorative announcement banner image"
										width="1200"
										height="1200"
										sizes="100vw"
										class="VtlsAnnouncementBannerImage__ImageDefault"
										role="presentation"
									>
								</div>
							{%- endif -%}
						</div>
					</div>
				{%- endif -%}
			</div>
			<div class="VtlsTextContent">
				<div class="VtlsTextBox {% if button_block.settings.primary_button_label == blank %}VtlsTextBox--withoutButton{% endif %}">
					{%- for block in section.blocks -%}
						{%- case block.type -%}
							{%- when "heading" -%}
								{%- if block.settings.heading_alternative_font -%}
									<style>
										{{- block.settings.heading_font | font_face: font_display: 'swap' -}}
									</style>
								{%- endif -%}
								{%- capture heading_css_variables -%}
																			--block-heading-size: {{- block.settings.heading_size -}}px;
																			--block-heading-color: {{- block.settings.heading_color -}};
																			--block-heading-font: {{- block.settings.heading_font.family | escape -}};
																		{%- endcapture -%}
								<h2
									style="{{- heading_css_variables | strip_newlines -}}"
									class="VtlsTextBox__Heading VtlsTextBox__Heading--style-{{ block.settings.heading_style }} {% if block.settings.heading_alternative_font == true %}VtlsTextBox__Heading--alternativeFont{% endif %}"
									{{ block.shopify_attributes }}
									id="announcement-heading-{{ section.id }}"
								>
									{{- block.settings.heading -}}
								</h2>
							{%- when "text" -%}
								{%- if block.settings.description_alternative_font -%}
									{%- liquid
										assign body_font_bold = block.settings.description_font | font_modify: "weight", "bold"
										assign body_font_italic = block.settings.description_font | font_modify: "style", "italic"
										assign body_font_bold_italic = body_font_bold | font_modify: "style", "italic"
									%}
									<style>
										{{- block.settings.description_font | font_face: font_display: 'swap' -}}
										{{ body_font_bold | font_face: font_display: 'swap' }}
										{{ body_font_italic | font_face: font_display: 'swap' }}
										{{ body_font_bold_italic | font_face: font_display: 'swap' }}
									</style>
								{%- endif -%}
								{%- capture description_css_variables -%}
																			--block-description-size: {{- block.settings.description_size -}}px;
																			--block-description-color: {{- block.settings.description_color -}};
																			--block-description-font: {{- block.settings.description_font.family | escape -}};
																		{%- endcapture -%}
								<div
									style="{{- description_css_variables | strip_newlines -}}"
									class="VtlsTextBox__Description VtlsTextBox__Description--alignment-{{ section.settings.text_alignment }} {% if block.settings.description_alternative_font == true %}VtlsTextBox__Description--alternativeFont{% endif %}"
									{{ block.shopify_attributes }}
								>
									{{- block.settings.description -}}
								</div>
						{%- endcase -%}
					{%- endfor -%}
				</div>
			</div>
			{%- if button_block -%}
				{%- capture button_css_variables -%}
							--block-primary-button-text-color: {{- button_block.settings.primary_text_color -}};
							--block-primary-button-background-color: {{- button_block.settings.primary_background_color -}};
							--block-primary-button-corner-radius: {{- button_block.settings.primary_button_corner -}}px;
							--block-primary-button-border-color: {{- button_block.settings.primary_border_color -}};
					{%- endcapture -%}
				<div
					style="{{- button_css_variables | strip_newlines -}}"
					class="VtlsAnnouncementBannerButton"
					{{ button_block.shopify_attributes }}
				>
					{%- if button_block.settings.primary_button_label != blank -%}
						{%- liquid
							# Split text into words
							assign words = button_block.settings.primary_button_label | split: " "
							assign total_words = words.size
							assign button_label = ""

							# Group words by 4 and join with <br>
							for i in (0..total_words)
								assign word_index = i | modulo: 4
								if word_index == 0 and i > 0
									assign button_label = button_label | append: "<br>"
								endif
								if i < total_words
									if word_index > 0
										assign button_label = button_label | append: " "
									endif
									assign button_label = button_label | append: words[i]
								endif
							endfor
						-%}
						<vtls-scroll-to-top-banner>
							{%- if button_block.settings.primary_button_behaviour == "link" -%}
								<a
									{% if button_block.settings.primary_new_tab == true %}
										target="_blank"
										rel="noopener noreferrer"
									{% endif %}
									class="VtlsAnnouncementBannerButton__Primary VtlsAnnouncementBannerButton__Primary--{{ button_block.settings.primary_button_style }}"
									href="{{ button_block.settings.primary_button_link }}"
								>
									{{- button_label -}}
								</a>
							{%- else -%}
								<button
									type="button"
									class="VtlsAnnouncementBannerButton__Primary VtlsAnnouncementBannerButton__Primary--{{ button_block.settings.primary_button_style }}"
									aria-label="Scroll to top"
									data-scroll-to-top
								>
									{{- button_label -}}
								</button>
							{%- endif -%}
						</vtls-scroll-to-top-banner>
					{%- endif -%}
				</div>
			{%- endif -%}
		</div>
	</div>
</section>

