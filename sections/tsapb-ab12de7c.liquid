<!-- --VERSION-15-- -->

{% style %}
:root {
--vtl-neutral-100: #222;
--vtl-neutral-70: #5e5e5e;
--vtl-neutral-03: #f8f8f8;
--vtl-neutral-01: #fff;
--vtl-blue-100: #0071e9;
--vtl-size-0: 0px;
--vtl-size-1: 1px;
--vtl-size-2: 2px;
--vtl-size-4: 4px;
--vtl-size-8: 8px;
--vtl-size-12: 12px;
--vtl-size-14: 14px;
--vtl-size-16: 16px;
--vtl-size-20: 20px;
--vtl-size-24: 24px;
--vtl-size-32: 32px;
--vtl-size-40: 40px;
--vtl-size-48: 48px;
--vtl-size-64: 64px;
--vtl-font-weight-400: 400;
--vtl-font-weight-600: 600;
--vtl-line-height-140: 1.4;
--vtl-text-decoration-none: none;
--vtl-text-decoration-underline: underline;
--vtl-border-width-1: var(--vtl-size-1);
--vtl-color-bg-fill-default-on-light: var(--vtl-neutral-100);
--vtl-color-bg-fill-inverse-on-light: var(--vtl-neutral-01);
--vtl-color-bg-surface-tertiary-on-light: var(--vtl-neutral-03);
--vtl-color-text-disable-on-light: var(--vtl-neutral-70);
--vtl-color-text-on-bg-fill-on-light: var(--vtl-neutral-01);
--vtl-color-border-default-on-light: var(--vtl-neutral-100);
--vtl-color-border-focus-on-light: var(--vtl-blue-100);
--vtl-space-0: var(--vtl-size-0);
--vtl-space-2: var(--vtl-size-2);
--vtl-space-4: var(--vtl-size-4);
--vtl-space-8: var(--vtl-size-8);
--vtl-space-12: var(--vtl-size-12);
--vtl-space-16: var(--vtl-size-16);
--vtl-space-20: var(--vtl-size-20);
--vtl-space-24: var(--vtl-size-24);
--vtl-space-32: var(--vtl-size-32);
--vtl-space-40: var(--vtl-size-40);
--vtl-space-48: var(--vtl-size-48);
--vtl-space-64: var(--vtl-size-64);
--vtl-font-size-14: var(--vtl-size-14);
}


{% endstyle %}

<!-- --UUID-ab12de7c-- -->

<section
	class="
		Vtls-{{ section.id | handle }} VtlsAnnouncementBanner
		VtlsAnnouncementBanner--backgroundStyle-{{ section.settings.section_background_style }}
	"
	aria-label="Announcement banner"
	role="banner"
>
	{%- liquid
		assign button_block = section.blocks | where: "type", "button" | first
		assign image_block = section.blocks | where: "type", "image" | first
		assign background_image = section.settings.background_image
		assign loading = "lazy"
		assign fetchpriority = "auto"
		assign preload = true

		if section.index == 1
			assign loading = "eager"
			assign fetchpriority = "high"
			assign preload = false
		endif
	-%}
	{%- if section.settings.section_background_style == "image" -%}
		<div class="VtlsAnnouncementBanner__BackgroundMedia" aria-hidden="true">
			{%- if background_image != blank -%}
				{{-
					background_image
					| image_url: width: background_image.width
					| image_tag:
						class: "VtlsAnnouncementBanner__BackgroundImage",
						sizes: "100vw",
						widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
						loading: loading,
						fetchpriority: fetchpriority,
						preload: preload
				-}}
			{%- else -%}
				<img
					src="data:image/webp;base64,"
					alt=""
					loading="{{ loading }}"
					fetchpriority="{{ fetchpriority }}"
					sizes="100vw"
					class="VtlsAnnouncementBanner__BackgroundImage"
					role="presentation"
				>
			{%- endif -%}
			<div class="VtlsAnnouncementBanner__BackgroundOverlay"></div>
		</div>
	{%- endif -%}
	<div
		class="
			VtlsAnnouncementBannerContainer
			   {% if section.settings.section_width == 100 %}VtlsAnnouncementBannerContainer--fullWidth{% endif %}
			VtlsAnnouncementBannerContainer--backgroundStyle-{{ section.settings.banner_background_style }}
			{% if section.settings.banner_background_style == "gradient" and section.settings.enable_animation == true %}VtlsAnnouncementBannerContainer--hasAnimation{% endif %}
			{% if section.settings.banner_border == true %}VtlsAnnouncementBannerContainer--hasBorder{% endif %}
			   VtlsAnnouncementBannerContainer--borderLocation-{{ section.settings.border_location }}
		"
	>
		{%- liquid
			assign max_width_value = section.settings.section_max_width | plus: 0
			assign is_column_layout = false
			if max_width_value > 0 and max_width_value <= 700
				assign is_column_layout = true
			endif
		-%}
		<div
			class="
				VtlsAnnouncementBannerContainerContent
				{% if is_column_layout %}VtlsAnnouncementBannerContainerContent--columnLayout{% endif %}
			"
		>
			<div class="VtlsImageContent" aria-hidden="true">
				{%- if image_block -%}
					{% capture vtls_icon %}
																	{% case image_block.settings.icon %}
